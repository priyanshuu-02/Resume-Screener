# Smart Resume Screener — Backend Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit .env to git.

# Google Gemini API key — get yours at https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Unstract LLMWhisperer API key — used to extract text from PDF/DOCX uploads
# Get your key at https://unstract.com/
UNSTRACT_API_KEY=your_unstract_api_key_here

# MongoDB connection string
# Local:  mongodb://localhost:27017/resume_screener
# Atlas:  mongodb+srv://<user>:<password>@cluster.mongodb.net/resume_screener
MONGODB_URI=mongodb://localhost:27017/resume_screener

# Server port — leave as 5000 for local dev
# On Render, PORT is injected automatically so you don't need to set it there
PORT=5000

# Allowed frontend origins (comma-separated, no trailing slash)
# Local:      http://localhost:5173
# Production: https://your-app.vercel.app
ALLOWED_ORIGINS=http://localhost:5173

# Max resume upload size in MB
MAX_FILE_SIZE_MB=10

# JWT secret — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_jwt_secret_here
