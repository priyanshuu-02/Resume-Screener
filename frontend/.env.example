# Frontend Environment Variables
# For local dev: copy to .env.local — leave VITE_API_URL blank to use Vite proxy

# Backend URL — set to your Render backend URL in production
# Leave empty for local dev (Vite proxy handles /api/* → localhost:5000)
VITE_API_URL=

# Google OAuth Client ID — only needed if you want Google Sign-In
# Leave empty to hide the Google button entirely (email/password still works)
# To enable: create a project at console.cloud.google.com and add your Vercel domain to authorized origins
VITE_GOOGLE_CLIENT_ID=
